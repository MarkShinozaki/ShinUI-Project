# ── Favicon Studio (Design Tools → /design-tools/favicon-studio) ─────────────
#
# Server-only OpenRouter key. Used when the visitor leaves the API key field empty.
# Never commit a real key (.env is gitignored). Never expose this as NEXT_PUBLIC_*.
OPENROUTER=

# Image models in the AI picker (public — safe to expose in the client bundle).
NEXT_PUBLIC_FAVICON_STUDIO_MODEL1=tencent/hy-image-v3.5-preview
NEXT_PUBLIC_FAVICON_STUDIO_MODEL2=google/gemini-2.5-flash-image
NEXT_PUBLIC_FAVICON_STUDIO_MODEL3=microsoft/mai-image-2.6-flash
